# ============================================================================
# WebChat AI - PRODUCTION-STYLE LOCAL SANDBOX configuration (TEMPLATE / EXAMPLE)
# ----------------------------------------------------------------------------
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# THIS FILE MUST ONLY EVER POINT AT DISPOSABLE / LOCAL SERVICES.
# It is the SAFE boot target for production-style local runs and the local
# smoke test. Copy it to `.env.production.sandbox` (gitignored) and keep every
# value pointing at local docker services (mongo / redis / mailpit) or empty.
# NEVER paste real production credentials here.
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
#
# COPY instructions:
#   cp .env.production.sandbox.example .env.production.sandbox
#   ./scripts/local-production-smoke-test.sh   # reads .env.production.sandbox
#
# Honest limitation:
#   ENVIRONMENT=development + PAYMENT_PROVIDER=mock + empty AI keys is the ONLY
#   secret-free configuration backend/core/config.py accepts. config.py rejects
#   PAYMENT_PROVIDER=mock in production mode and requires >=1 generation AI key
#   + a real payment gateway key there (LOCAL_PRODUCTION_TEST=true only relaxes
#   loopback/URL checks). A true ENVIRONMENT=production local sandbox requires
#   operator-supplied TEST payment + AI keys; see "Manual sandbox upgrade" in
#   docs/deployment/README.md.
#
# Isolation guarantees (from PRODUCTION):
#   - MONGODB_URI / REDIS_URL / email / payments / AI  -> local docker ONLY
#   - REDIS_PREFIX=webchat_ai_sandbox -> the sandbox ARQ worker queue is a
#     separate namespace; a sandbox worker can NEVER pick up production jobs.
#   - No real secrets present; zero external spend / mail / charges.
#
# https:// URL-conservation note: this file keeps the public URLs (Railway/Vercel
# contract) OUT of the environment by design - sandbox only talks to localhost.
# ============================================================================


# ============================================================================
# GENERAL
# ============================================================================
# Deliberately DEVELOPMENT mode (see "Honest limitation" above).
ENVIRONMENT=development

APP_NAME=webchat-ai

DEBUG=false

ENABLE_DOCS=false

PERF_TIMING_LOG_ENABLED=false

LOG_LEVEL=INFO


# ============================================================================
# BACKEND (FastAPI)
# ============================================================================
BACKEND_HOST=0.0.0.0

BACKEND_PORT=8000

CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:5500","http://localhost:5500"]

PUBLIC_BASE_URL=http://localhost:3000


# ============================================================================
# SECURITY
# ============================================================================
# Generate a fresh disposable value with: openssl rand -hex 32
JWT_SECRET=CHANGEME_SANDBOX_JWT_MIN_32_CHARS_0123456789abcdef

JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

JWT_ALGORITHM=HS256

COOKIE_SECURE=false

REFRESH_COOKIE_NAME=refresh_token

CSRF_COOKIE_NAME=csrf_token

EMAIL_VERIFY_TOKEN_EXPIRE_MINUTES=1440

PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

RATE_LIMIT_ENABLED=true

API_KEY_RATE_LIMIT_PER_MINUTE=300

TRUST_PROXY=false

ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,::1

LOCAL_PRODUCTION_TEST=false


# ============================================================================
# DATABASE - local docker mongo ONLY (never production Atlas)
# ============================================================================
MONGODB_URI=mongodb://mongo:27017

# Reuses the local dev DB so dev seeding also populates the sandbox. To fully
# isolate the sandbox DB use webchat_ai_sandbox (you must seed it yourself).
MONGODB_DB=webchat_ai

MONGODB_MIN_POOL_SIZE=10

MONGODB_MAX_POOL_SIZE=100

MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000

MONGODB_SLOW_QUERY_THRESHOLD_MS=0

MONGO_USERNAME=

MONGO_PASSWORD=


# ============================================================================
# REDIS - local docker redis ONLY (never production Upstash)
# ============================================================================
REDIS_URL=redis://redis:6379

# Separate ARQ namespace so the sandbox worker only ever consumes sandbox jobs.
REDIS_PREFIX=webchat_ai_sandbox

REDIS_PASSWORD=


# ============================================================================
# EMAIL - local Mailpit only; NO real Resend key.
# ============================================================================
RESEND_API_KEY=

EMAIL_FROM=riturajlabs@outlook.com

MAILPIT_API_URL=http://mailpit:8025


# ============================================================================
# AI PROVIDERS - leave EMPTY (zero external spend). Add ONE real key (gemini /
# groq / openrouter, same as development) to validate the full chat path; the
# smoke test SKIPs the chat assertion while no generation key is configured.
# ============================================================================
GEMINI_API_KEY=

GEMINI_MODEL=gemini-2.5-flash

EMBEDDING_MODEL=gemini-embedding-001

GENERATION_PROVIDER_ORDER=["gemini","groq","openrouter"]

EMBEDDING_PROVIDER_ORDER=["gemini","jina","cohere"]

GROQ_API_KEY=

GROQ_MODEL=openai/gpt-oss-20b

OPENROUTER_API_KEY=

OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

AI_PROVIDER_TIMEOUT_SECONDS=60

EMBEDDING_DIMENSIONS=1024

JINA_API_KEY=

JINA_EMBEDDING_MODEL=jina-embeddings-v3

JINA_EMBEDDING_DIMENSIONS=1024

COHERE_API_KEY=

COHERE_EMBEDDING_MODEL=embed-multilingual-v3.0

COHERE_EMBEDDING_DIMENSIONS=1024


# ============================================================================
# KNOWLEDGE / ANALYTICS / RAG / CRAWLER
# ============================================================================
KNOWLEDGE_CHUNK_SIZE_TOKENS=700

KNOWLEDGE_CHUNK_OVERLAP_TOKENS=100

EMBEDDING_BATCH_SIZE=32

EMBEDDING_MAX_RETRIES=5

EMBEDDING_RETRY_BASE_DELAY_MS=500

EMBEDDING_REQUEST_TIMEOUT_SECONDS=60

KNOWLEDGE_MAX_DOCUMENT_RETRIES=3

KNOWLEDGE_RETRY_BASE_DELAY_SECONDS=5

KNOWLEDGE_RETRY_BACKOFF_FACTOR=6

KNOWLEDGE_MIN_CONTENT_CHARS=100

COST_PER_MILLION_INPUT_TOKENS=0.30

COST_PER_MILLION_OUTPUT_TOKENS=1.50

RAG_PROMPT_VERSION=1

CHAT_TOP_K=5

CHAT_MEMORY_TURNS=8

CHAT_CONTEXT_CHUNK_CHARS=4000

CHAT_QUESTION_MAX_CHARS=2000

CHAT_MAX_OUTPUT_TOKENS=1024

CHAT_TEMPERATURE=0.2

GENERATION_TIMEOUT_SECONDS=60

CHAT_RETENTION_DAYS=90

USAGE_RETENTION_DAYS=1095

CRAWL_MAX_PAGES=50

CRAWL_MAX_DEPTH=3

CRAWL_NAVIGATION_TIMEOUT_MS=30000

CRAWL_MAX_HTML_BYTES=5000000

CRAWL_MAX_CONTENT_BYTES=200000

CRAWL_MAX_CONCURRENT=2

CRAWL_BROWSER_USER_AGENT=WebChatAI-Crawler/1.0

CRAWL_NO_SANDBOX=true


# ============================================================================
# WIDGET
# ============================================================================
WIDGET_API_BASE_URL=http://localhost:8000

# Keep EMPTY: local bundle must stay loopback-free (check-assets gate).
VITE_WIDGET_API_BASE_URL=

WIDGET_SCRIPT_URL=http://localhost:8080/webchat-widget.iife.min.js

WIDGET_SESSION_TOKEN_MINUTES=15

WIDGET_SESSION_VALIDITY_HOURS=24

WIDGET_CONFIG_CACHE_SECONDS=300

WIDGET_PER_WIDGET_LIMIT=60

WIDGET_PER_VISITOR_LIMIT=20

WIDGET_SESSION_ISSUE_LIMIT=30

WIDGET_FEEDBACK_LIMIT=30

WIDGET_IP_LIMIT=120

WIDGET_MAX_MESSAGES_PER_SESSION=50

WIDGET_RATE_LIMIT_ENABLED=true


# ============================================================================
# BILLING / PAYMENTS - mock (offline, no keys, no real charges).
# ============================================================================
PAYMENT_PROVIDER=mock

PAYMENT_CURRENCY=USD

STRIPE_SECRET_KEY=

STRIPE_WEBHOOK_SECRET=

RAZORPAY_KEY_ID=

RAZORPAY_KEY_SECRET=

RAZORPAY_WEBHOOK_SECRET=


# ============================================================================
# ADMIN / DASHBOARD / DOCKER / TOOLING
# ============================================================================
SUPER_ADMIN_EMAILS=["dev@example.com"]

# BUILD-TIME ONLY (compose build arg). WEBCHAT_ALLOW_LOCALHOST_BUILD=true is
# required for the loopback dashboard URL below.
NEXT_PUBLIC_API_URL=http://localhost:8000

# NOTE: docker/compose.yml does not wire NEXT_PUBLIC_BACKEND_API_URL as a build
# arg, so next.config.ts uses its built-in Railway fallback for server rewrites
# (/api/*). Sandbox UI reaches the local API via NEXT_PUBLIC_API_URL above.
WEBCHAT_ALLOW_LOCALHOST_BUILD=true

DOCKER_BRIDGE_MTU=1280

# Optional tooling defaults (scripts + smoke test).
API_BASE_URL=http://localhost:8000

MAILPIT_URL=http://localhost:8025

API_BASE=http://localhost:8000/api/widget/v1

WIDGET_ID=

E2E_BASE_URL=http://localhost:8000

E2E_MAILPIT_URL=http://localhost:8025

E2E_WIDGET_SCRIPT_URL=http://localhost:8080/webchat-widget.iife.min.js
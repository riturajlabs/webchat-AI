# ============================================================================
# WebChat AI - Production environment template (zero-cost deployment)
# Copy to .env.production (or your secret manager) and fill in real values.
# NEVER commit a filled .env* file. docker compose reads these variables from
# the shell / your CI environment and fails fast (`:?`) on any missing one.
# See docs/DEPLOYMENT.md and docs/ZERO_COST_DEPLOYMENT.md.
# ============================================================================

# --- Stack / image tagging ---
# REGISTRY=ghcr.io/your-org
# ORG=your-org
# TAG=v1.0.0
# Host port the HTTP vhost is published on (compose only; nginx listens on
# ${PORT:-80} inside the container - Railway injects PORT automatically).
HTTP_PORT=80
# Host port for the optional TLS vhost (compose only).
HTTPS_PORT=443
# Container listen port for the HTTP vhost. Leave unset (-> 80) for compose;
# Railway injects PORT on the gateway service.
# PORT=80
# Container listen port for the optional TLS vhost (ENABLE_TLS=1).
# NGINX_HTTPS_PORT=443
# Gateway upstreams (host:port). Compose defaults target the services in
# docker-compose.prod.yml; on Railway set them to the private service URLs
# (Railway private networking), e.g. NGINX_API_UPSTREAM=api.prod.<project>.up.railway.app.
NGINX_API_UPSTREAM=api:8000
NGINX_WIDGET_UPSTREAM=widget:80
NGINX_DASHBOARD_UPSTREAM=dashboard:3000
# Enable the nginx TLS vhost (1) or serve plain HTTP (0) - the latter when a
# fronting LB / CDN (e.g. Cloudflare or Railway) terminates TLS.
ENABLE_TLS=0
# Directory with fullchain.pem + privkey.pem when ENABLE_TLS=1.
TLS_CERT_DIR=./tls

# --- API ---
ENVIRONMENT=production
DEBUG=false
# Base origin the widget SDK targets; the app appends /api/widget/v1 itself.
# In the single-origin deployment this equals the dashboard origin.
WIDGET_API_BASE_URL=https://app.example.com
# Public API origin baked into the dashboard bundle at build time
# (Next.js NEXT_PUBLIC_* is inlined at build time, not read at runtime).
NEXT_PUBLIC_API_URL=https://app.example.com
# Observability: keep off in production.
PERF_TIMING_LOG_ENABLED=false

# --- Security ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-<32+ random bytes>
# HTTPS-only auth cookies (must stay true behind TLS; false only behind an LB
# that terminates HTTP and you understand the cookie-exposure tradeoff).
COOKIE_SECURE=true
# Trusted host-header values the API accepts (TrustedHostMiddleware). One per
# public origin; loopback is always auto-allowed for container healthchecks.
# Comma-separated or JSON array.
ALLOWED_HOSTS=app.example.com
# Reverse-proxy trust: keep true behind nginx/Cloudflare so client IPs from
# X-Forwarded-For are honored for rate limiting.
TRUST_PROXY=true
# Rate limiting must stay enabled in production (boot-validated).
RATE_LIMIT_ENABLED=true
# Per-API-key sliding window.
API_KEY_RATE_LIMIT_PER_MINUTE=300

# --- MongoDB Atlas (M0 free tier) ---
# M0 has no Vector Search index: the API auto-falls back to exact brute-force
# cosine retrieval (backend/repositories/vector/mongodb.py). Keep the app
# indexes - init_indexes() creates them idempotently at startup.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=webchat_ai
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=100
MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000

# --- Redis (external URL required; Upstash free tier or a VM container) ---
# Any RESP provider is accepted; TLS URLs use rediss://.
REDIS_URL=rediss://user:pass@host:6379
REDIS_PREFIX=webchat_ai

# --- AI providers (at least one generation key required) ---
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# Ordered fallback chains (JSON arrays).
GENERATION_PROVIDER_ORDER=["gemini","groq","openrouter"]
EMBEDDING_PROVIDER_ORDER=["gemini"]
EMBEDDING_MODEL=gemini-embedding-001
# Vector length for the primary embedding provider. On M0 this is not used by
# an index but must stay consistent with the corpus if you later upgrade.
EMBEDDING_DIMENSIONS=3072
AI_PROVIDER_TIMEOUT_SECONDS=60

# --- Email (Resend; auto-selected when ENVIRONMENT=production) ---
RESEND_API_KEY=re_...
EMAIL_FROM=WebChat AI <no-reply@example.com>

# --- Widget CDN ---
# HTTPS URL of the CONTENT-HASHED widget bundle served by Cloudflare Pages
# (e.g. https://<project>.pages.dev/webchat-widget.iife.min.<hash>.js) or by
# nginx under /widget/. Point at the hashed bundle so the CDN can cache it
# immutable; the stable webchat-widget.iife.min.js copy is for dev/e2e only.
WIDGET_SCRIPT_URL=https://app.example.com/widget/webchat-widget.iife.min.js
# Widget API limits (production hardening; app-level).
WIDGET_SESSION_TOKEN_MINUTES=15
WIDGET_SESSION_VALIDITY_HOURS=24
WIDGET_CONFIG_CACHE_SECONDS=300
WIDGET_PER_WIDGET_LIMIT=60
WIDGET_PER_VISITOR_LIMIT=20
WIDGET_SESSION_ISSUE_LIMIT=30
WIDGET_FEEDBACK_LIMIT=30
WIDGET_IP_LIMIT=120
WIDGET_MAX_MESSAGES_PER_SESSION=50
WIDGET_RATE_LIMIT_ENABLED=true

# --- Dashboard URL / CORS ---
# JSON array of dashboard origins. Loopback and wildcard origins are rejected
# in production (config.py fails fast).
CORS_ORIGINS=["https://app.example.com"]
# Dashboard origin (used in email verification / password reset links).
PUBLIC_BASE_URL=https://app.example.com

# --- Payments (Phase 14) ---
# Production requires a real gateway with its keys (mock is a boot error).
PAYMENT_PROVIDER=stripe
PAYMENT_CURRENCY=USD
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Platform operations (Phase 15) ---
# JSON array of emails granted `super_admin` (admin API). Empty = admin
# disabled (403 for everyone).
SUPER_ADMIN_EMAILS=["ops@example.com"]

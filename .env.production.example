# ============================================================================
# WebChat AI - PRODUCTION environment configuration (TEMPLATE / EXAMPLE)
# ----------------------------------------------------------------------------
# COPY this file to `.env.production` and replace every `CHANGEME_*` /
# `YOUR_*` / `example.com` placeholder with real deployment values BEFORE
# deploying. This file is committed (no secrets); `.env.production` is
# gitignored and must NEVER be committed.
#
# config.py FAILS FAST on any leftover placeholder or dev default (e.g. the
# CHANGEME_* JWT_SECRET below), so a copy of this template will not boot until
# it is fully parameterized. After replacing every placeholder this template
# satisfies backend/core/config.py's production validators:
#   - ENVIRONMENT=production, DEBUG=false, ENABLE_DOCS=false
#   - COOKIE_SECURE=true, RATE_LIMIT_ENABLED=true
#   - CORS_ORIGINS / WIDGET_SCRIPT_URL / WIDGET_API_BASE_URL / ALLOWED_HOSTS
#     are all real HTTPS / public hosts (no localhost, no wildcards)
#   - MongoDB + Redis are AUTHENTICATED (credentials embedded or supplied via
#     MONGO_USERNAME/MONGO_PASSWORD/REDIS_PASSWORD)
#   - AI spend protection limits (Phase 14.9.4) are set to safe non-zero values
#
# Generate secrets with: openssl rand -hex 32   (JWT_SECRET, etc.)
# ============================================================================


# ============================================================================
# GENERAL
# ============================================================================

ENVIRONMENT=production

APP_NAME=webchat-ai

DEBUG=false

PERF_TIMING_LOG_ENABLED=false

# Disable OpenAPI docs in production (expose no internal API surface).
ENABLE_DOCS=false


# ============================================================================
# BACKEND (FastAPI)
# ============================================================================

BACKEND_HOST=0.0.0.0

BACKEND_PORT=8000

# Real HTTPS dashboard origin(s) — config.py rejects loopback/wildcard.
CORS_ORIGINS=["https://app.example.com"]

# Public HTTPS dashboard URL used in email verification / password reset links.
PUBLIC_BASE_URL=https://app.example.com


# ============================================================================
# SECURITY
# ============================================================================

# Generate with: openssl rand -hex 32   (>= 32 bytes). CHANGE BEFORE DEPLOY.
JWT_SECRET=CHANGEME_CHANGEME_CHANGEME_CHANGEME_CHANGEME_CHANGEME_CHANGEME_CHANGEME1234567890

JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

JWT_ALGORITHM=HS256

# HTTPS-only auth cookies in production.
COOKIE_SECURE=true

REFRESH_COOKIE_NAME=refresh_token

CSRF_COOKIE_NAME=csrf_token

EMAIL_VERIFY_TOKEN_EXPIRE_MINUTES=1440

PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Account lockout (SEC-3): failed-login throttle.
LOGIN_MAX_ATTEMPTS=5

LOGIN_LOCKOUT_MINUTES=15

REFRESH_RATE_LIMIT_PER_MINUTE=30

# Rate limiting MUST stay enabled in production (boot-validated).
RATE_LIMIT_ENABLED=true

API_KEY_RATE_LIMIT_PER_MINUTE=300

# Set true when the API sits behind a trusted reverse proxy / LB so
# X-Forwarded-For is honored for rate-limit client IPs.
TRUST_PROXY=true

# Real public API hostname(s) — config.py rejects loopback-only lists.
ALLOWED_HOSTS=api.example.com

# NEVER set this in a real deployment (it relaxes URL/host validation).
# LOCAL_PRODUCTION_TEST=false

# Structured log level (INFO/DEBUG/WARNING/ERROR) and the max accepted request
# body bytes (FastAPI middleware).
LOG_LEVEL=INFO

REQUEST_BODY_MAX_BYTES=10485760


# ============================================================================
# DATABASE (MongoDB) — Phase 14.9.2
# ============================================================================

# Either embed credentials here (user:pass@host) OR set MONGO_USERNAME /
# MONGO_PASSWORD below; production requires authentication.
MONGODB_URI=mongodb+srv://webchat-ai:CHANGE_ME_MONGO_PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# Plaintext admin credentials used to seed the docker `mongo` service and to
# satisfy the production auth validator when MONGODB_URI does not embed them.
# For managed MongoDB (Atlas) set these to the database user/pass used in the
# URI above; they are forwarded to the mongo container only in docker runs.
MONGO_USERNAME=webchat-ai
MONGO_PASSWORD=CHANGE_ME_MONGO_PASSWORD

MONGODB_DB=webchat_ai

MONGODB_MIN_POOL_SIZE=10

MONGODB_MAX_POOL_SIZE=100

MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000

MONGODB_SOCKET_TIMEOUT_MS=30000

MONGODB_SLOW_QUERY_THRESHOLD_MS=0


# ============================================================================
# REDIS — Phase 14.9.3
# ============================================================================

# Embed the password (redis://:pass@host) OR set REDIS_PASSWORD below.
REDIS_URL=rediss://default:CHANGE_ME_REDIS_PASSWORD@your-redis.upstash.io:6379

# Forwarded to the docker `redis` service to enable `requirepass`. Use the same
# value as the password in REDIS_URL.
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

REDIS_PREFIX=webchat_ai


# ============================================================================
# EMAIL (production delivery via Resend)
# ============================================================================

# Resend API key (real value). Never commit the real key.
RESEND_API_KEY=YOUR_RESEND_API_KEY

# Verified custom-domain sender (NOT the onboarding@resend.dev sandbox).
EMAIL_FROM=WebChat AI <noreply@example.com>

# Unused in production (Resend delivers); leave empty so compose does not fall
# back to the local Mailpit service.
MAILPIT_API_URL=


# ============================================================================
# AI PROVIDERS
# ============================================================================

GEMINI_API_KEY=YOUR_GEMINI_API_KEY

GEMINI_MODEL=gemini-2.5-flash

EMBEDDING_MODEL=gemini-embedding-001

GENERATION_PROVIDER_ORDER=["gemini","groq","openrouter"]

EMBEDDING_PROVIDER_ORDER=["gemini","jina","cohere"]

GROQ_API_KEY=YOUR_GROQ_API_KEY

GROQ_MODEL=openai/gpt-oss-20b

OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

AI_PROVIDER_TIMEOUT_SECONDS=60

AI_PROVIDER_ROUTING_MODE=adaptive

AI_PROVIDER_COOLDOWN_SECONDS=60

AI_PROVIDER_HEALTH_CHECK_INTERVAL=300

AI_PROVIDER_RECOVERY_WINDOW_SECONDS=120

EMBEDDING_DIMENSIONS=1024

JINA_API_KEY=YOUR_JINA_API_KEY

JINA_EMBEDDING_MODEL=jina-embeddings-v3

JINA_EMBEDDING_DIMENSIONS=1024

COHERE_API_KEY=YOUR_COHERE_API_KEY

COHERE_EMBEDDING_MODEL=embed-multilingual-v3.0

COHERE_EMBEDDING_DIMENSIONS=1024


# ============================================================================
# AI SPEND PROTECTION — Phase 14.9.4
# ============================================================================

# Per-tenant cumulative token budgets and a per-minute request ceiling,
# enforced in Redis. 0 disables that specific limit (unlimited). Tune to your
# plan tiers; values below are conservative starting points.
LLM_DAILY_TOKEN_LIMIT=2000000
LLM_MONTHLY_TOKEN_LIMIT=50000000
LLM_REQUEST_LIMIT_PER_MINUTE=60


# Generation retries / prompt window for LLM providers.
LLM_MAX_RETRIES=2

LLM_RETRY_BASE_DELAY=1.0

LLM_MAX_CONTEXT_TOKENS=30000


# ============================================================================
# ANALYTICS (Phase 13)
# ============================================================================

COST_PER_MILLION_INPUT_TOKENS=0.30

COST_PER_MILLION_OUTPUT_TOKENS=1.50


# ============================================================================
# RAG PIPELINE (Phase 6)
# ============================================================================

RAG_PROMPT_VERSION=1

CHAT_TOP_K=5

CHAT_MEMORY_TURNS=8

CHAT_CONTEXT_CHUNK_CHARS=2500

CHAT_CONTEXT_MAX_CHARS=12000

CHAT_CONTEXT_MIN_SCORE=0.56

CHAT_QUESTION_MAX_CHARS=2000

CHAT_MAX_OUTPUT_TOKENS=512

CHAT_TEMPERATURE=0.2

GENERATION_TIMEOUT_SECONDS=60

GENERATION_FIRST_TOKEN_TIMEOUT_SECONDS=10

CHAT_RETENTION_DAYS=90

USAGE_RETENTION_DAYS=1095

ENABLE_HYBRID_SEARCH=true

HYBRID_RRF_K=60

HYBRID_SEARCH_CANDIDATE_LIMIT=50

ENABLE_RERANKING=true

RERANK_TOP_K=5

ENABLE_ADAPTIVE_RETRIEVAL=false

ADAPTIVE_SIMPLE_TOP_K=4

ADAPTIVE_SIMPLE_RERANK_TOP_K=3

ADAPTIVE_SIMPLE_MAX_CONTEXT_CHARS=8000

ADAPTIVE_COMPLEX_TOP_K=12

ADAPTIVE_COMPLEX_RERANK_TOP_K=8

ADAPTIVE_COMPLEX_MAX_CONTEXT_CHARS=30000

# Fantasy-premise guard: rewrite context-dependent follow-ups before embedding.
ENABLE_CONVERSATIONAL_QUERY_REWRITE=true

ENABLE_FAITHFULNESS_CHECK=true

FAITHFULNESS_WARNING_THRESHOLD=0.6

ENABLE_RAG_CONFIDENCE_CHECK=true

RAG_CONFIDENCE_THRESHOLD=0.65

ENABLE_CONTEXT_OPTIMIZATION=false

EMBEDDING_CACHE_SIZE=256

EMBEDDING_CACHE_TTL_SECONDS=3600

CHAT_RETRIEVAL_CACHE_SIZE=512

CHAT_RETRIEVAL_CACHE_TTL_SECONDS=900

CHAT_EMBEDDING_MAX_RETRIES=1

SSE_BUFFER_MS=50

SSE_IDLE_TIMEOUT=1800

GEMINI_EMBEDDING_DIMENSIONS=1024

# Bump to invalidate cached embeddings when the embedding model/dimensions change.
EMBEDDING_VERSION=1


# ============================================================================
# CRAWLER (Phase 4 ingestion engine)
# ============================================================================

CRAWL_MAX_PAGES=50

CRAWL_MAX_DEPTH=3

CRAWL_NAVIGATION_TIMEOUT_MS=30000

CRAWL_MAX_HTML_BYTES=5000000

CRAWL_MAX_CONTENT_BYTES=200000

CRAWL_MAX_CONCURRENT=2

CRAWL_BROWSER_USER_AGENT=WebChatAI-Crawler/1.0

# Set false behind a non-root production image (Chrome sandbox).
CRAWL_NO_SANDBOX=true


# ============================================================================
# WIDGET
# ============================================================================

# Runtime HTTPS API origin embedded in generated embed snippets.
WIDGET_API_BASE_URL=https://api.example.com

# Build-time API base baked into the widget bundle. Set to your real HTTPS API
# origin BEFORE building the widget image (inlined at build time).
VITE_WIDGET_API_BASE_URL=https://api.example.com

# Widget script URL used in generated embed snippets (real HTTPS CDN).
WIDGET_SCRIPT_URL=https://cdn.example.com/webchat-widget.iife.min.js

WIDGET_SESSION_TOKEN_MINUTES=15

WIDGET_SESSION_VALIDITY_HOURS=24

WIDGET_CONFIG_CACHE_SECONDS=300

WIDGET_PER_WIDGET_LIMIT=60

WIDGET_PER_VISITOR_LIMIT=20

WIDGET_SESSION_ISSUE_LIMIT=30

WIDGET_FEEDBACK_LIMIT=30

WIDGET_IP_LIMIT=120

WIDGET_CHAT_IP_LIMIT=90

WIDGET_SESSION_ISSUE_IP_LIMIT=30

WIDGET_MAX_MESSAGES_PER_SESSION=50

WIDGET_RATE_LIMIT_ENABLED=true


# ============================================================================
# BILLING / PAYMENTS (real gateway)
# ============================================================================

# stripe or razorpay (never mock in production; boot-validated).
PAYMENT_PROVIDER=razorpay

PAYMENT_CURRENCY=USD

STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY

STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET

RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID

RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# The webhook SIGNING SECRET (whsec_...), NOT a webhook URL.
RAZORPAY_WEBHOOK_SECRET=whsec_CHANGE_ME_RAZORPAY_WEBHOOK_SECRET


# ============================================================================
# ADMIN
# ============================================================================

# Real emails granted the super_admin role (JSON array).
SUPER_ADMIN_EMAILS=["admin@example.com"]


# ============================================================================
# DASHBOARD (Next.js, frontend)
# ============================================================================

# Public HTTPS API origin inlined into the Next.js client bundle at build time.
NEXT_PUBLIC_API_URL=https://api.example.com

# Optional public HTTPS origins inlined into embed snippets and developer docs.
# When unset they are derived from SITE_URL (or its default), so they only need
# to be set when the widget bundle, widget API and dashboard live on distinct
# hosts (e.g. a CDN). A build-time guard rejects ".example" and loopback hosts.
# NEXT_PUBLIC_SITE_URL=https://app.example.com
# NEXT_PUBLIC_WIDGET_SCRIPT_URL=https://cdn.example.com/webchat-widget.iife.min.js
# NEXT_PUBLIC_WIDGET_API_URL=https://api.example.com/api/widget/v1
# NEXT_PUBLIC_DASHBOARD_URL=https://app.example.com


# ============================================================================
# DOCKER
# ============================================================================

DOCKER_BRIDGE_MTU=1500

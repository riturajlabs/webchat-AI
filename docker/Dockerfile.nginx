# WebChat AI - production reverse proxy (Phase 16 / Railway adaptation).
# Build context: repo root (see docker-compose.prod.yml).
# Single origin: /api -> API, /widget -> widget SDK host, / -> dashboard.
#
# Vhost configs are rendered at startup from /etc/nginx/conf.d.tpl/*.template
# by /docker-entrypoint.d/20-render-config.sh (env-driven upstreams + PORT).
# The same image runs behind docker compose (defaults) or as the public
# Railway gateway (PORT + NGINX_*_UPSTREAM + ENABLE_TLS=0).

FROM nginx:1.27-alpine

# Replace the stock config with ours (which includes conf.d/*.conf).
COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf
# The base image's default.conf would conflict on port 80, so it is removed.
RUN rm -f /etc/nginx/conf.d/default.conf
# Vhost templates + the entrypoint script that renders them at startup.
COPY docker/nginx/conf.d.tpl/ /etc/nginx/conf.d.tpl/
COPY docker/nginx/docker-entrypoint.d/20-render-config.sh /docker-entrypoint.d/20-render-config.sh
RUN chmod +x /docker-entrypoint.d/20-render-config.sh

EXPOSE 80 443

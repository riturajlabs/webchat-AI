# WebChat AI widget SDK (framework-independent IIFE/ESM/UMD bundles)
# Build context: repo root (see docker/compose.yml)
# Serves the built dist so the embed script can be hosted and smoke-tested.

FROM node:22-alpine AS base
# Pin the exact pnpm version declared in package.json (corepack's registry
# fetch proved flaky in some CI environments; npm install is deterministic).
RUN npm install -g pnpm@11.13.1
# husky's `prepare` hook cannot run without a .git dir (excluded via .dockerignore).
ENV HUSKY=0

FROM base AS builder
WORKDIR /app
# The widget bundle bakes the API origin at build time so the SaaS host can
# ship one bundle that talks to the right backend from any customer domain.
# docker compose passes VITE_WIDGET_API_BASE_URL from the selected env file
# (see .env.example). Keep it EMPTY for local dev AND local production testing
# so the bundle stays loopback-free; the check-assets gate rejects loopback
# hosts on purpose. For a real production build (e.g. Railway) set it to the
# HTTPS API origin before building - it cannot be changed at runtime.
ARG VITE_WIDGET_API_BASE_URL=""
ENV VITE_WIDGET_API_BASE_URL="${VITE_WIDGET_API_BASE_URL}"
# All workspace manifests must be present for `pnpm install` to resolve.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/dashboard/package.json apps/dashboard/package.json
COPY apps/widget/package.json apps/widget/package.json
# Generous fetch settings: builds must survive slow/flaky registry responses.
RUN pnpm config set fetch-timeout 600000 \
    && pnpm config set fetch-retries 10 \
    && pnpm config set fetch-retry-maxtimeout 180000 \
    && pnpm install --frozen-lockfile
COPY . .
RUN pnpm --filter @webchat/widget build

FROM nginx:1.27-alpine AS runner
COPY docker/nginx.widget.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/widget/dist /usr/share/nginx/html

# Non-root user for production (SEC-14.2).
# nginx alpine: use the built-in nginx user (uid 101) which already exists.
# Ensure html directory is readable.
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown nginx:nginx /var/run/nginx.pid

EXPOSE 80

# Default healthcheck (can be overridden): the stable widget bundle must exist.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- --spider http://127.0.0.1/webchat-widget.iife.min.js

USER nginx

# WebChat AI dashboard (Next.js 15, standalone server output)
# Build context: repo root (see docker/compose.yml)

FROM node:22-alpine AS base
# Pin the exact pnpm version declared in package.json (corepack's registry
# fetch proved flaky in some CI environments; npm install is deterministic).
RUN npm install -g pnpm@11.13.1
# husky's `prepare` hook cannot run without a .git dir (excluded via .dockerignore).
ENV HUSKY=0

FROM base AS deps
WORKDIR /app
# All workspace manifests must be present for `pnpm install` to resolve.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/dashboard/package.json apps/dashboard/package.json
COPY apps/widget/package.json apps/widget/package.json
# Generous fetch settings: builds must survive slow/flaky registry responses.
RUN pnpm config set fetch-timeout 600000 \
    && pnpm config set fetch-retries 10 \
    && pnpm config set fetch-retry-maxtimeout 180000 \
    && pnpm install --frozen-lockfile

FROM base AS builder
WORKDIR /app
# NEXT_PUBLIC_* variables are inlined into the client bundle at build time.
# Pass the API origin via `--build-arg NEXT_PUBLIC_API_URL=...` (docker
# compose does this automatically; defaults to the local dev fallback).
ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ENV NEXT_PUBLIC_API_URL="${NEXT_PUBLIC_API_URL}"
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN pnpm --filter @webchat/dashboard build

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000
COPY --from=builder /app/apps/dashboard/.next/standalone ./
COPY --from=builder /app/apps/dashboard/.next/static ./apps/dashboard/.next/static
EXPOSE 3000
CMD ["node", "apps/dashboard/server.js"]

# WebChat AI - HTTP vhost (rendered at startup by 20-render-config.sh).
#
# Listen port and upstreams are environment-driven so the SAME image serves
# either docker-compose (defaults below) or Railway (PORT + NGINX_*_UPSTREAM
# pointing at private service URLs).
#
# Substitution is restricted to a fixed allowlist (see 20-render-config.sh);
# nginx runtime variables such as $host, $scheme, $remote_addr and
# $proxy_add_x_forwarded_for are preserved verbatim.

server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    # Internal healthcheck endpoint for the nginx container itself.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # --- API ---
    location /api/ {
        limit_req zone=api_general burst=60 nodelay;
        proxy_pass http://${NGINX_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        # SSE (chat streams): never buffer.
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # --- Auth endpoints: strict edge rate limit (5 req/min) ---
    location ~ ^/api/(auth/(login|register|forgot-password|resend-verification|refresh)|webhooks/) {
        limit_req zone=auth_strict burst=10 nodelay;
        proxy_pass http://${NGINX_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    # --- Widget SDK bundles (content-hashed assets cached immutable upstream) ---
    location /widget/ {
        limit_req zone=widget_assets burst=30 nodelay;
        proxy_pass http://${NGINX_WIDGET_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # --- Dashboard on the /dashboard alias (rewritten before proxying) ---
    location = /dashboard {
        return 301 /dashboard/;
    }
    location /dashboard/ {
        rewrite ^/dashboard/(.*)$ /$1 break;
        proxy_pass http://${NGINX_DASHBOARD_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # --- Dashboard root (single-origin deployment) ---
    location / {
        proxy_pass http://${NGINX_DASHBOARD_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

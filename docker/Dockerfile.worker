# WebChat AI ARQ background worker (crawler, embeddings, email)
# Build context: repo root (see docker/compose.yml)

FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim AS worker

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    UV_HTTP_TIMEOUT=600 \
    UV_CONCURRENT_DOWNLOADS=8 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app

# Install dependencies first (cached layer). A flaky PyPI connection resets
# large downloads mid-transfer; uv retries each file internally, so retry the
# whole sync (uv reuses its wheel cache, making retries cheap) before failing.
COPY pyproject.toml uv.lock README.md ./
RUN set -e; for attempt in 1 2 3 4 5; do \
      uv sync --no-dev --no-install-project --frozen && exit 0; \
      echo "uv sync attempt $attempt failed; retrying in 15s..."; \
      sleep 15; \
    done; \
    exit 1

# Copy application code
COPY backend/ ./backend/

# Install the project itself
RUN set -e; for attempt in 1 2 3; do \
      uv sync --no-dev --frozen && exit 0; \
      echo "uv sync attempt $attempt failed; retrying in 15s..."; \
      sleep 15; \
    done; \
    exit 1

# Drop the uv wheel/download cache so it does not leak into the runtime layer.
RUN uv cache clean

# Phase 4: headless Chromium for the Playwright crawler (docs/06, ADR-002).
# `--with-deps` pulls the browser's runtime libraries onto bookworm-slim.
# The apt package index is removed afterward so it does not bloat the image.
RUN /app/.venv/bin/python -m playwright install --with-deps chromium && \
    rm -rf /var/lib/apt/lists/* /root/.cache/ms-playwright-download

# Non-root user for production (SEC-14.2).
# Playwright/Chromium requires specific capabilities:
#   - /ms-playwright and /app must be readable by appuser
#   - Chromium sandbox is controlled via CRAWL_NO_SANDBOX env var
#   - When running as non-root with sandbox enabled, Chromium uses a
#     user namespace sandbox (no SUID needed). When sandbox is disabled
#     (--no-sandbox), no special permissions are required.
RUN addgroup --system --gid 1001 appgroup && \
    adduser  --system --uid 1001 --ingroup appgroup --no-create-home appuser && \
    chown -R appuser:appgroup /app && \
    chown -R appuser:appgroup /ms-playwright

ENV PATH="/app/.venv/bin:$PATH"

USER appuser

CMD ["python", "-m", "backend.workers"]

# WebChat AI ARQ background worker (crawler, embeddings, email)
# Build context: repo root (see docker/compose.yml)

FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim AS worker

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app

# Install dependencies first (cached layer)
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --no-dev --no-install-project --frozen

# Copy application code
COPY backend/ ./backend/

# Install the project itself
RUN uv sync --no-dev --frozen

# Phase 4: headless Chromium for the Playwright crawler (docs/06, ADR-002).
# `--with-deps` pulls the browser's runtime libraries onto bookworm-slim.
RUN /app/.venv/bin/python -m playwright install --with-deps chromium

ENV PATH="/app/.venv/bin:$PATH"

CMD ["python", "-m", "backend.workers"]

# WebChat AI API server
# Build context: repo root (see docker/compose.yml)

FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim AS api

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    UV_HTTP_TIMEOUT=600 \
    UV_CONCURRENT_DOWNLOADS=8

WORKDIR /app

# Install dependencies first (cached layer). A flaky PyPI connection resets
# large downloads mid-transfer; uv retries each file internally, so retry the
# whole sync (uv reuses its wheel cache, making retries cheap) before failing.
COPY pyproject.toml uv.lock README.md ./
RUN set -e; for attempt in 1 2 3 4 5; do \
      uv sync --no-dev --no-install-project --frozen && exit 0; \
      echo "uv sync attempt $attempt failed; retrying in 15s..."; \
      sleep 15; \
    done; \
    exit 1

# Copy application code
COPY backend/ ./backend/

# Install the project itself
RUN set -e; for attempt in 1 2 3; do \
      uv sync --no-dev --frozen && exit 0; \
      echo "uv sync attempt $attempt failed; retrying in 15s..."; \
      sleep 15; \
    done; \
    exit 1

# Non-root user for production (SEC-14.2)
RUN addgroup --system --gid 1001 appgroup && \
    adduser  --system --uid 1001 --ingroup appgroup --no-create-home appuser && \
    chown -R appuser:appgroup /app

ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8000

# Default healthcheck (can be overridden by the orchestrator): probe the
# liveness endpoint, which deliberately avoids dependency I/O so a MongoDB/
# Redis partition never causes an orchestrator to restart a healthy process.
# Use /api/health/ready for readiness gating instead (it fails closed 503).
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health/live', timeout=4)"

USER appuser

# Run as many uvicorn workers as UVICORN_WORKERS (default 1). The compose file
# forwards it; keep it at 1 per container unless DB-pool/serving profiling
# justifies more (vertical scaling via compose deploy.limits is preferred).
CMD ["sh", "-c", "exec uvicorn backend.main:app --host 0.0.0.0 --port 8000 --workers \"${UVICORN_WORKERS:-1}\""]

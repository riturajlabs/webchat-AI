# ============================================================================
# WebChat AI - Environment Variables
# Copy to .env and fill in real values. Never commit .env files.
# See docs/06-Implementation-Plan.md and docs/07-Architecture-Decisions.md
# ============================================================================

# --- General ---
ENVIRONMENT=development
APP_NAME=webchat-ai
DEBUG=true

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
# Base URL used in email verification / password reset links
PUBLIC_BASE_URL=http://localhost:3000

# --- Security ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# --- MongoDB ---
# Local dev default (native MongoDB or `docker compose` - see note below).
# Production: MongoDB Atlas URI, e.g. mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=webchat_ai
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=100

# --- Redis ---
# Local dev default (native Redis or `docker compose` - see note below).
# Production: Upstash/Redis Cloud RESP URL (must support RESP/TLS, ADR-002).
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=webchat_ai

# NOTE: docker/compose.dev.yml overrides MONGODB_URI/REDIS_URL to the service
# names ("mongodb://mongo:27017", "redis://redis:6379") for the api/worker
# containers. The localhost values above are for running the API/worker
# directly on the host with scripts/dev-api.sh and scripts/dev-worker.sh.

# --- Email (Phase 2; see ADR-001) ---
RESEND_API_KEY=
EMAIL_FROM=WebChat AI <no-reply@webchatai.example>

# --- AI (Phase 4-6) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# --- Widget ---
WIDGET_API_BASE_URL=http://localhost:8000/api/widget/v1

# ============================================================================
# WebChat AI - Environment Variables (template)
# ----------------------------------------------------------------------------
# 1. This template documents every variable the project can read. Copy it to
#    `.env` (or use one of the ready-made files) and fill in real values.
#    NEVER commit a filled `.env` / `.env.development` / `.env.production`.
# 2. Two ready-made environment files ship with the repo:
#      .env.development  -> local docker services (MongoDB/Redis/Mailpit),
#                           DEBUG=true, COOKIE_SECURE=false,
#                           PAYMENT_PROVIDER=mock, LOCAL_PRODUCTION_TEST=false.
#      .env.production   -> ENVIRONMENT=production for LOCAL PRODUCTION
#                           TESTING: external managed services (Atlas MongoDB,
#                           managed Redis, Resend, real AI keys) with localhost
#                           app URLs + LOCAL_PRODUCTION_TEST=true.
# 3. Every variable maps to a field on backend/core/config.py (Settings), a
#    docker compose build/runtime variable, or a frontend build-time variable.
#
# Placeholders used in this template (never put real credentials here):
#   CHANGE_ME         -> JWT_SECRET (generate with: openssl rand -hex 32)
#   YOUR_API_KEY      -> any provider API key (Gemini, Groq, OpenRouter,
#                        Resend, Stripe, Razorpay)
#   YOUR_DATABASE_URL -> external managed database/queue URLs (MongoDB Atlas,
#                        Upstash/Redis Cloud)
#   your.domain.com   -> your real public domains
#
# LEGEND
#   [required]  -> must be set for the app to boot / function in that env
#   [optional]  -> only set when you need the feature/override
#   [dev]       -> development usage only
#   [prod]      -> production usage only
#   [build]     -> read at BUILD time only (Next.js / Vite bundle); changing it
#                  at runtime does nothing to an already-built image
#
# ENVIRONMENT SWITCHING
# ----------------------------------------------------------------------------
# ENVIRONMENT=development  -> uses LOCAL services:
#     MONGODB_URI      mongodb://mongo:27017   (docker mongo service)
#     REDIS_URL        redis://redis:6379      (docker redis service)
#     MAILPIT_API_URL  http://mailpit:8025     (docker mailpit service)
#     DEBUG=true, COOKIE_SECURE=false, localhost CORS allowed, payments stay
#     "mock", and mail goes to Mailpit. docker/compose.yml passes these values
#     (and every secret - AI/RESEND keys, JWT_SECRET) straight through to the
#     api/worker containers via ${VAR-default}; compose NEVER overrides a value
#     set in the selected env file. Change the URIs here to point development
#     at any other MongoDB/Redis/Mailpit.
#     Run:  docker compose --env-file .env.development -f docker/compose.yml up --build
#
# ENVIRONMENT=production   -> uses EXTERNAL managed services:
#     MONGODB_URI      MongoDB Atlas connection string (mongodb+srv://...)
#     REDIS_URL        managed Redis with TLS (rediss://YOUR_REDIS_URL:6379)
#     Email via Resend, HTTPS URLs, COOKIE_SECURE=true.
#     config.py fails fast at boot on weak production values:
#       - CORS_ORIGINS / ALLOWED_HOSTS must be non-loopback HTTPS hosts
#         (unless LOCAL_PRODUCTION_TEST=true)
#       - JWT_SECRET must be at least 32 bytes
#       - at least one AI generation provider key is required
#       - PAYMENT_PROVIDER must be "stripe" or "razorpay" with real keys
#       - RATE_LIMIT_ENABLED must stay true
#
# LOCAL PRODUCTION TESTING (the current .env.production state)
# ----------------------------------------------------------------------------
# ENVIRONMENT=production + LOCAL_PRODUCTION_TEST=true lets you exercise every
# production code path (JSON logs, Resend mail, real payment gateways, rate
# limiting) on your machine over plain HTTP:
#     ENVIRONMENT=production
#     DEBUG=false
#     LOCAL_PRODUCTION_TEST=true        <- accepts the localhost URLs below
#     COOKIE_SECURE=false               <- localhost is plain HTTP
#     TRUST_PROXY=false
#     PUBLIC_BASE_URL=http://localhost:3000
#     CORS_ORIGINS=["http://localhost:3000"]
#     ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,::1
#     WIDGET_API_BASE_URL=http://localhost:8000
#     WIDGET_SCRIPT_URL=http://localhost:8080/webchat-widget.iife.min.js
#     NEXT_PUBLIC_API_URL=http://localhost:8000   [build]
#     VITE_WIDGET_API_BASE_URL=          keep EMPTY (loopback-free bundle gate)
#   Run:  docker compose --env-file .env.production -f docker/compose.yml up --build
#
#   LOCAL_PRODUCTION_TEST ONLY relaxes URL/host validation. All other
#   production checks still apply. It must be false/unset in any real
#   deployment (Railway etc.) - it is an explicit opt-in, never automatic.
#
# RAILWAY DEPLOYMENT (later - nothing to code)
# ----------------------------------------------------------------------------
# Set these in the Railway project environment (they become container env vars;
# no env file is shipped). Only URL/domain and provider credentials change:
#     LOCAL_PRODUCTION_TEST=false (or unset)
#     COOKIE_SECURE=true, TRUST_PROXY=true
#     PUBLIC_BASE_URL=https://app.your-domain.com
#     CORS_ORIGINS=["https://app.your-domain.com"]
#     ALLOWED_HOSTS=api.your-domain.com
#     WIDGET_API_BASE_URL=https://api.your-domain.com
#     VITE_WIDGET_API_BASE_URL=https://api.your-domain.com  [build]
#     WIDGET_SCRIPT_URL=https://cdn.your-domain.com/webchat-widget.iife.min.<hash>.js
#     NEXT_PUBLIC_API_URL=https://api.your-domain.com       [build]
#     REDIS_URL=<real managed Redis URL>, STRIPE_* / RAZORPAY_* = real keys,
#     SUPER_ADMIN_EMAILS=["you@your-domain.com"]
#   VITE_WIDGET_API_BASE_URL and NEXT_PUBLIC_API_URL are baked into the bundle
#   at build time - set them before the Railway build; runtime env changes do
#   not reach an already-built bundle.
# ============================================================================

# --- General --- [required]
# "development" or "production". Controls the app mode: DEBUG, cookie policy,
# CORS/trusted-host validation, email provider and payment validation.
ENVIRONMENT=development
APP_NAME=webchat-ai
# [dev] true, [prod] false
DEBUG=true
# Per-request timing logs (observability); keep off in production. [optional]
PERF_TIMING_LOG_ENABLED=false
# Local production testing (see header). [optional - LOCAL PRODUCTION TEST ONLY]
# false/empty normally; NEVER set in a real deployment (Railway etc.).
LOCAL_PRODUCTION_TEST=false

# --- Backend (FastAPI) --- [required]
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Development / local production test: localhost origins are fine.
# Production: HTTPS dashboard origin(s) only (config.py rejects loopback and
# wildcard origins and enforces https:// unless LOCAL_PRODUCTION_TEST=true).
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:5500","http://localhost:5500"]
# Base URL used in email verification / password reset links. [required]
# Development / local production test: http://localhost:3000.
# Production: https://app.your-domain.com
PUBLIC_BASE_URL=http://localhost:3000

# --- Security --- [required]
# Generate with: openssl rand -hex 32  (>= 32 bytes in production)
JWT_SECRET=CHANGE_ME
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# Auth cookies (ADR-003). [required]
# Development / local production test: false over plain HTTP (localhost).
# Production: true - HTTPS-only cookies.
COOKIE_SECURE=false
# Cookie names (rarely overridden; defaults shown). [optional]
REFRESH_COOKIE_NAME=refresh_token
CSRF_COOKIE_NAME=csrf_token
# Email verification link lifetime (minutes). [optional]
EMAIL_VERIFY_TOKEN_EXPIRE_MINUTES=1440
# Password reset link lifetime (minutes, single-use via pwd_token_version). [optional]
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Rate limiting (ADR-004). Disable only in tests. [required]
RATE_LIMIT_ENABLED=true
# Sliding window for authenticated API keys (requests/minute). [optional]
API_KEY_RATE_LIMIT_PER_MINUTE=300

# Reverse-proxy trust. Enable ONLY when the API sits behind a trusted proxy
# (e.g. Cloudflare/LB/Railway proxy) so `X-Forwarded-For` is used for client IP
# in rate limiting. When false (default) the direct connection IP is used.
# [dev] false, [prod] true when behind a trusted proxy. [optional]
TRUST_PROXY=false

# Trusted Host-header values (TrustedHostMiddleware). Comma-separated or JSON
# array. Loopback hosts are always auto-allowed for healthchecks.
# Development / local production test: localhost hosts below.
# Production: must include the public hostname(s), e.g. api.your-domain.com,
# and rejects `*` (config.py requires at least one non-loopback host unless
# LOCAL_PRODUCTION_TEST=true). [required]
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,::1

# --- MongoDB --- [required]
# docker/compose.yml is .env-driven: the value below is what the api/worker
# containers get. Development uses the local docker `mongo` service (container
# name on the webchat network); host-run dev (scripts/dev-api.sh) needs
# mongodb://localhost:27017 instead. Production uses an external managed
# MongoDB (MongoDB Atlas), e.g.
#     mongodb+srv://YOUR_DATABASE_URL/?retryWrites=true&w=majority
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=webchat_ai
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=100
# Server-selection timeout (ms). The test suite lowers this to 1000 to fail fast.
MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000
# Log queries slower than this (ms); 0 = disabled. [optional]
MONGODB_SLOW_QUERY_THRESHOLD_MS=0

# --- Redis --- [required]
# docker/compose.yml is .env-driven: development uses the local docker
# `redis` service (container name on the webchat network); host-run dev needs
# redis://localhost:6379 instead. Production uses managed Redis (RESP/TLS,
# ADR-002), e.g. rediss://YOUR_REDIS_URL:6379
REDIS_URL=redis://redis:6379
REDIS_PREFIX=webchat_ai

# --- Email ---
# Development: Mailpit catch-all. docker/compose.yml passes the value below
#     (http://mailpit:8025 container name; web UI: http://localhost:8025) to the
#     api/worker containers. Host-run dev uses http://localhost:8025.
#     Note: the mail service always uses Mailpit in development, so a
#     RESEND_API_KEY here is ignored.
# Production  : real delivery via Resend. RESEND_API_KEY [required] and a
#     verified EMAIL_FROM are required; leave MAILPIT_API_URL EMPTY (compose
#     preserves the empty value - it must not fall back to the local service).
RESEND_API_KEY=YOUR_API_KEY
EMAIL_FROM=WebChat AI <no-reply@webchatai.example>
MAILPIT_API_URL=http://mailpit:8025

# --- AI (Phase 4-6) ---
# GEMINI_API_KEY [required] for embeddings + primary generation. Example format:
#     (paste a real key into .env; never commit one)
GEMINI_API_KEY=YOUR_API_KEY
GEMINI_MODEL=gemini-2.5-flash
# Primary embedding model. Gemini output is truncated to EMBEDDING_DIMENSIONS
# (outputDimensionality) so it matches the Jina/Cohere fallback vectors.
EMBEDDING_MODEL=gemini-embedding-001

# --- AI provider fallback (Phase 9, ADR-009) ---
# Ordered fallback chains (JSON arrays). Providers are tried in order; a
# provider whose API key is missing is skipped, and the next one is tried.
# Unknown names are a configuration error and fail fast. [required]
GENERATION_PROVIDER_ORDER=["gemini","groq","openrouter"]
EMBEDDING_PROVIDER_ORDER=["gemini","jina","cohere"]
# Groq (OpenAI-compatible generation fallback). https://console.groq.com/keys [optional]
GROQ_API_KEY=YOUR_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile
# OpenRouter (OpenAI-compatible generation fallback). https://openrouter.ai/keys [optional]
OPENROUTER_API_KEY=YOUR_API_KEY
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# Shared HTTP timeout for non-Gemini providers (seconds). Kept low so a hung
# upstream fails fast into the fallback chain instead of stalling the chat.
AI_PROVIDER_TIMEOUT_SECONDS=10
# Vector length the MongoDB `$vectorSearch` index expects. EVERY provider in
# EMBEDDING_PROVIDER_ORDER must emit this dimension: Gemini is truncated to it
# via outputDimensionality, and Jina/Cohere must declare a matching
# JINA_EMBEDDING_DIMENSIONS/COHERE_EMBEDDING_DIMENSIONS (validated at boot).
# The 1024 default matches jina-embeddings-v3 / embed-multilingual-v3.0. [required]
EMBEDDING_DIMENSIONS=1024
# Gemini-specific embedding dimensions. gemini-embedding-001 supports 1..3072;
# the native default is 3072. Must match EMBEDDING_DIMENSIONS when Gemini is in
# the fallback chain (validated at boot). Separated so Gemini can run at full
# 3072 when Jina/Cohere are not in the chain. [required when gemini in chain]
GEMINI_EMBEDDING_DIMENSIONS=1024
# Jina AI (cloud embedding fallback). https://jina.ai/embeddings/ [optional]
# Free tier: 1M tokens/month. A missing key skips this provider gracefully.
JINA_API_KEY=YOUR_API_KEY
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_EMBEDDING_DIMENSIONS=1024
# Cohere (cloud embedding fallback). https://dashboard.cohere.com/api-keys [optional]
# Free trial tier. A missing key skips this provider gracefully.
COHERE_API_KEY=YOUR_API_KEY
COHERE_EMBEDDING_MODEL=embed-multilingual-v3.0
COHERE_EMBEDDING_DIMENSIONS=1024
# Mock (deterministic, keyless; offline dev / performance runs only). Add
# "mock" to the orders above to serve every generation/embedding request
# without a network call. Never use it as a production provider.

# --- Knowledge processing (Phase 5) --- [optional]
# Approximate-token chunk sizing (docs/02-TRD.md §6): 500-800 tokens/chunk.
KNOWLEDGE_CHUNK_SIZE_TOKENS=700
KNOWLEDGE_CHUNK_OVERLAP_TOKENS=100
# Embedding API: texts per request, retry count and base backoff for the
# exponential schedule, per-request timeout (seconds). GEMINI_API_KEY is used.
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_BASE_DELAY_MS=300
EMBEDDING_REQUEST_TIMEOUT_SECONDS=10
# Document processing: max retries and exponential backoff schedule.
KNOWLEDGE_MAX_DOCUMENT_RETRIES=3
KNOWLEDGE_RETRY_BASE_DELAY_SECONDS=5
KNOWLEDGE_RETRY_BACKOFF_FACTOR=6
# Minimum cleaned-text length (chars) for a page to be stored as a document.
KNOWLEDGE_MIN_CONTENT_CHARS=100

# --- Analytics (Phase 13) --- [optional]
# Estimated token cost per million tokens, used for usage/cost reporting.
COST_PER_MILLION_INPUT_TOKENS=0.30
COST_PER_MILLION_OUTPUT_TOKENS=1.50

# --- RAG pipeline (Phase 6) --- [optional]
# Versioned answer prompt selected from backend/prompts/rag.py.
RAG_PROMPT_VERSION=1
# Retrieval depth: tenant-filtered Top-5 vector search (ADR-008).
CHAT_TOP_K=5
# Conversation turns fed to the model as memory (most recent N).
CHAT_MEMORY_TURNS=8
# Per-chunk context cap when building the prompt (characters).
CHAT_CONTEXT_CHUNK_CHARS=4000
# Question sanitization cap (prompt-injection defense).
CHAT_QUESTION_MAX_CHARS=2000
# Total context budget across all retrieved chunks (characters) and an
# optional minimum vector-search score (0 = no filter).
CHAT_CONTEXT_MAX_CHARS=12000
CHAT_CONTEXT_MIN_SCORE=0.0
# Bounded in-memory retrieval cache: repeat questions inside the TTL skip the
# embedding + vector search (answers are never cached).
CHAT_RETRIEVAL_CACHE_TTL_SECONDS=900
CHAT_RETRIEVAL_CACHE_SIZE=512
# Fail-fast chat embedding: single retry for the primary provider.
CHAT_EMBEDDING_MAX_RETRIES=1
# Generation settings for the Gemini answer stream.
CHAT_MAX_OUTPUT_TOKENS=1024
CHAT_TEMPERATURE=0.2
GENERATION_TIMEOUT_SECONDS=30
# Max seconds to wait for the FIRST answer token; after that the provider is
# treated as unavailable and the fallback chain is tried.
GENERATION_FIRST_TOKEN_TIMEOUT_SECONDS=10
# Conversation/session retention in days (ADR-005 §5.7, TTL 90d safety net).
CHAT_RETENTION_DAYS=90
# Daily usage rollup retention (ADR-005 §5.7: 3 years).
USAGE_RETENTION_DAYS=1095

# --- Ingestion engine (Phase 4) --- [optional]
# Max pages crawled per job, max link depth from the seed URL.
CRAWL_MAX_PAGES=50
CRAWL_MAX_DEPTH=3
# Per-navigation timeout for the headless Chromium fetcher (ms).
CRAWL_NAVIGATION_TIMEOUT_MS=30000
# Cap on one page's rendered HTML (bytes) and on the cleaned text stored (bytes).
CRAWL_MAX_HTML_BYTES=5000000
CRAWL_MAX_CONTENT_BYTES=200000
# Max crawl jobs running simultaneously in one worker process (memory safety).
CRAWL_MAX_CONCURRENT=2
CRAWL_BROWSER_USER_AGENT=WebChatAI-Crawler/1.0
# Chrome sandbox: set false behind a non-root production image.
CRAWL_NO_SANDBOX=true

# --- Widget ---
# RUNTIME API origin the widget SDK targets. The backend renders it into the
# embed snippet as `data-api-base-url`, which the SDK honors above the built-in
# default. The widget appends `/api/widget/v1` itself, so a host origin (or a
# fully versioned path) is accepted. [required]
# Development / local production test: http://localhost:8000.
# Production: HTTPS API origin (config.py hard-fails on loopback hosts unless
# LOCAL_PRODUCTION_TEST=true).
WIDGET_API_BASE_URL=http://localhost:8000
# [build] Build-time API base baked into the widget bundle (`import.meta.env`).
# Keep EMPTY locally AND during local production testing: the bundle must stay
# loopback-free (apps/widget/scripts/check-assets.mjs gate). The live widget
# reaches the API via `data-api-base-url` (WIDGET_API_BASE_URL) at runtime.
# Production: set to your real HTTPS API origin BEFORE building the widget
# image - changing the runtime env does nothing to an already-built bundle.
VITE_WIDGET_API_BASE_URL=
# Absolute URL of the built widget script referenced in the embed snippet
# returned when a website is created (backend/widget_script_url). [required]
# Development / local production test: http://localhost:8080/webchat-widget.iife.min.js
# (docker widget service). The stable-name copy is only for local dev/e2e.
# Production: HTTPS CDN/host; point at the CONTENT-HASHED bundle
# (`webchat-widget.iife.min.<hash>.js`) so the CDN can cache it immutable.
# config.py hard-fails on loopback hosts unless LOCAL_PRODUCTION_TEST=true.
WIDGET_SCRIPT_URL=http://localhost:8080/webchat-widget.iife.min.js
# Public widget API (Phase 8, ADR-004): [optional]
# Widget session JWT lifetime (minutes) and 24h sliding validity window (hours).
WIDGET_SESSION_TOKEN_MINUTES=15
WIDGET_SESSION_VALIDITY_HOURS=24
# Public config Redis cache TTL (seconds).
WIDGET_CONFIG_CACHE_SECONDS=300
# Per-widget / per-visitor chat rate limits (per minute) and session-issue limit.
WIDGET_PER_WIDGET_LIMIT=60
WIDGET_PER_VISITOR_LIMIT=20
WIDGET_SESSION_ISSUE_LIMIT=30
# Per-visitor feedback submissions per minute (Phase 12.4).
WIDGET_FEEDBACK_LIMIT=30
# Per-IP budget per widget endpoint / minute (production hardening). Backs up
# the entity-keyed limits above, which a hostile client can rotate via the
# client-supplied visitor_id / widget_id.
WIDGET_IP_LIMIT=120
# Dedicated per-IP burst budgets (P0-4) for anonymous token minting (/sessions)
# and SSE generation (/chat). Tighter than WIDGET_IP_LIMIT because both
# endpoints' entity keys (visitor_id, target widget_id) are attacker-chosen;
# these windows survive that rotation. Honor WIDGET_RATE_LIMIT_ENABLED.
WIDGET_SESSION_ISSUE_IP_LIMIT=30
WIDGET_CHAT_IP_LIMIT=60
# Per-conversation message cap.
WIDGET_MAX_MESSAGES_PER_SESSION=50
# Widget rate-limit master switch (defaults to RATE_LIMIT_ENABLED when unset).
WIDGET_RATE_LIMIT_ENABLED=true

# --- Payments (Phase 14, SaaS subscriptions) ---
# Gateway implementation: "stripe", "razorpay" or "mock" (offline dev/tests).
# Development: "mock" needs no keys.
# Production (incl. local production test): "stripe" or "razorpay" with the
# gateway keys - config.py fails fast at boot otherwise. [required]
PAYMENT_PROVIDER=mock
# ISO 4217 currency billed via checkout (plan prices are its minor units). [optional]
PAYMENT_CURRENCY=USD
# Stripe: API secret key (sk_live_/sk_test_) and the webhook signing secret
# (whsec_...) from the dashboard's webhook endpoint configuration. [prod required]
STRIPE_SECRET_KEY=YOUR_API_KEY
STRIPE_WEBHOOK_SECRET=YOUR_API_KEY
# Razorpay: API key id/secret and the webhook signing secret configured on the
# Razorpay dashboard. [prod required]
RAZORPAY_KEY_ID=YOUR_API_KEY
RAZORPAY_KEY_SECRET=YOUR_API_KEY
RAZORPAY_WEBHOOK_SECRET=YOUR_API_KEY

# --- Platform operations (Phase 15, SaaS admin) ---
# JSON array of emails granted the `super_admin` role - the only role allowed
# on the /api/admin/* surface. Empty = admin API disabled (403 for everyone).
# [prod] set real emails. [optional]
SUPER_ADMIN_EMAILS=[]

# --- Dashboard (Next.js, frontend) ---
# [build] Base URL of the backend API, inlined into the Next.js client bundle
# at build time (process.env.NEXT_PUBLIC_API_URL). docker compose passes it as
# a build arg. Development / local production test: http://localhost:8000.
# Production: public HTTPS API origin set BEFORE the dashboard image is built;
# changing the runtime env does nothing to an already-built bundle. [required]
NEXT_PUBLIC_API_URL=http://localhost:8000
# docker/compose.yml network MTU (bytes). Set to your host's path MTU when
# containers cannot complete outbound TLS (Docker defaults to 1500; a VPN
# tunnel, e.g. 1280, silently drops oversized handshake packets). [optional]
DOCKER_BRIDGE_MTU=1280

# --- Optional development tooling (NOT used in production) ---
# Consumed by scripts/seed-widget.py, scripts/verify_widget_chat.py and
# tests/e2e (defaults are hardcoded in each tool, so these are overrides).
# Include them in .env.development; they are intentionally absent from
# .env.production. All optional.
API_BASE_URL=http://localhost:8000
MAILPIT_URL=http://localhost:8025
API_BASE=http://localhost:8000/api/widget/v1
WIDGET_ID=
E2E_BASE_URL=http://localhost:8000
E2E_MAILPIT_URL=http://localhost:8025
E2E_WIDGET_SCRIPT_URL=http://localhost:8080/webchat-widget.iife.min.js
# Perf harness (scripts/perf/*) - passed to k6 via -e flags / shell exports.
REDIS_PORT=6380
PERF_API=http://127.0.0.1:8001
PERF_EMAIL=perf@example.com
PERF_PASSWORD=perf-password-123
PERF_WEBSITE=
PERF_QUESTION_POOL=What are the API rate limits?
